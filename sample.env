# ╔══════════════════════════════════════════════════════════════════╗
# ║  RezebbTunes — Unified Environment Configuration               ║
# ║  ⚠️ DO NOT PUT REAL KEYS HERE — use: cp sample.env .env        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Telegram API (required) ──────────────────────────────────────
API_ID=
API_HASH=
TOKEN=

# ── Pyrogram session strings for assistant userbots (STRING1 req) ─
STRING1=
STRING2=
STRING3=
STRING4=
STRING5=
STRING6=
STRING7=
STRING8=
STRING9=
STRING10=

# ── MongoDB (required) ───────────────────────────────────────────
MONGO_URI=
DB_NAME=RezebbTunes

# ── Bot Owner / Logging ──────────────────────────────────────────
OWNER_ID=
LOGGER_ID=
DEVS=

# ── Music Bot Settings ───────────────────────────────────────────
API_URL=
API_KEY=
DEFAULT_SERVICE=youtube
MIN_MEMBER_COUNT=50
MAX_FILE_SIZE=524288000
DOWNLOADS_DIR=database/music
PROXY=
COOKIES_URL=
AUTO_LEAVE=True

# ── Startup / Branding ───────────────────────────────────────────
START_IMG=https://i.pinimg.com/1200x/e8/89/d3/e889d394e0afddfb0eb1df0ab663df95.jpg
IGNORE_BACKGROUND_UPDATES=True
NO_UPDATES=False

# ── Support Links ────────────────────────────────────────────────
SUPPORT_GROUP=
SUPPORT_CHANNEL=

# ── Group Management Settings (from LadyRezebb) ──────────────────
# Space-separated user IDs for each permission tier:
DRAGONS=
DEV_USERS=
DEMONS=
TIGERS=
WOLVES=

# Blacklisted group IDs (space-separated):
BL_CHATS=

# Group management behavior:
ALLOW_CHATS=True
ALLOW_EXCL=True
DEL_CMDS=True
INFOPIC=True
STRICT_GBAN=True

# Module loading control (space-separated module names):
LOAD=
NO_LOAD=

# ── API Keys (optional, for specific group-management features) ──
# AlphaVantage: https://www.alphavantage.co/support/#api-key
CASH_API_KEY=
# TimezoneDB: https://timezonedb.com/api
TIME_API_KEY=
